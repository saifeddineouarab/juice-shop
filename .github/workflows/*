name: DevSecOps Pipeline (SAST - SCA - DAST)

on:
  push:
    branches: [ master, main ]
  pull_request:
    branches: [ master, main ]

permissions:
  contents: read
  security-events: write

jobs:
  sast-semgrep:
    name: 1. SAST - Semgrep Scan
    runs-on: ubuntu-latest
    steps:
      # Kat'jib l'code source dyal l'repo l'runner GitHub
      - name: Checkout code
        uses: actions/checkout@v4

      # Kat'installi Semgrep via Python pip
      - name: Install Semgrep
        run: pip install semgrep

      # Kat'lancer l'scan SAST b règles sécurité JS/TS/Node o kat'ssauvegardi rapport JSON o SARIF
      - name: Run Semgrep SAST
        run: |
          mkdir -p reports
          semgrep scan \
            --config p/security-audit \
            --config p/javascript \
            --config p/typescript \
            --json -o reports/semgrep-report.json \
            --sarif -o reports/semgrep-report.sarif \
            . || true

      # Kat'رفع les rapports l'Artifacts dyal GitHub Actions bach t9der t'telechargihom
      - name: Upload SAST Reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: sast-semgrep-reports
          path: reports/
